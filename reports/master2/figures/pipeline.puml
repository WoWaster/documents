@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowColor #666666
skinparam nodesep 24
skinparam ranksep 36
left to right direction
skinparam rectangle {
  BackgroundColor #F5F7FA
  BorderColor #AAB4C0
}

rectangle "**1. Получение матриц**\n\nmain.py download\n\nматрицы скачиваются\nпо ссылкам из настроек\nи распаковываются" as s1
rectangle "**2. Предобработка**\n\nmain.py prepare-matrices\n\nнеотрицательные целые,\nпереупорядоченные\nверсии" as s2
rectangle "**3. Измерения**\n\nmain.py benchmark <tool>\n\nповторные запуски\nпри разном числе\nпотоков" as s3
rectangle "**4. Результаты**\n\nresults/raw/\n\nобщий формат,\nпригодный для\nпостроения графиков" as s4

s1 --> s2
s2 --> s3
s3 --> s4
@enduml
